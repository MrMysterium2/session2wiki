# Copy this file to ".env" and fill in your own values.
# ".env" itself is excluded from version control (see .gitignore).

# --- log-start -------------------------------------------------------------
LOG_START_LOGDIR="/home/user/logs"
LOG_START_WIKI_CONTAINER="mediawiki"
LOG_START_WIKI_PAGE="Logs"
LOG_START_WIKI_USER="Admin"
LOG_START_WIKI_URL="https://your-wiki.example"

# --- wiki-edit.sh ------------------------------------------------------------
# Recommended: create a dedicated MediaWiki BotPassword account
# (Special:BotPasswords) instead of using your main admin account.
WIKI_EDIT_URL="https://your-wiki.example"
WIKI_EDIT_BOTUSER="YourUser@bot-name"
WIKI_EDIT_BOTPASS="change-me"
